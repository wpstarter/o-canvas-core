{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "wpstarter/o-canvas-core",
    "description": "Code Generators Builder for Laravel Applications and Packages",
    "type": "library",
    "license": "MIT",
    "authors": [

    ],
    "autoload": {
        "psr-4": {
            "Orchestra\\Canvas\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Canvas\\Core\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3.0",
        "symfony/polyfill-php83": "^1.33"
    },
    "require-dev": {
        "wpstarter/framework": "^2.1",
        "mockery/mockery": "^1.6.10",
        "wpstarter/o-testbench-core": "^2.1",
        "phpstan/phpstan": "^2.1.17",
        "phpunit/phpunit": "^11.5.12|^12.0.1",
        "symfony/yaml": "^7.2"
    },
    "config": {
        "audit": {
            "ignore": {
                "GHSA-78fx-h6xr-vch4": "Affected component is not in use"
            }
        },
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/orchestral/canvas/issues"
    },
    "extra": {
        "wpstarter": {
            "providers": [
                "Orchestra\\Canvas\\Core\\LaravelServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "@php vendor/bin/pint --ansi --parallel",
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ],
        "test": "@php vendor/bin/phpunit -c ./ --color",
        "ci": [
            "@composer audit",
            "@prepare",
            "@lint",
            "@test"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
